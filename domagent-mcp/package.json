{
    "name": "domagent",
    "private": true,
    "version": "6.1.0-beta.6",
    "description": "MCP server for DOMAgent — let AI agents control your real browser via Chrome or Firefox extension",
    "main": "dist/domagent-mcp/index.js",
    "type": "module",
    "bin": {
        "domagent": "./dist/domagent-mcp/index.js"
    },
    "scripts": {
        "start": "node dist/domagent-mcp/index.js",
        "dev": "tsx index.ts",
        "typecheck": "tsc -p . --noEmit && tsc -p ../domagent-extension && tsc -p ../domagent-extension/ui --noEmit",
        "test": "node --import tsx --test test/*.test.js ../domagent-extension/test/*.test.js && npm --prefix ../domagent-extension/ui test",
        "build:service": "tsc -p .",
        "build": "npm run build:service && node ../scripts/build-extensions.mjs",
        "test:browser": "npm run build:service && playwright test --config ../domagent-extension/playwright.config.cjs",
        "check": "node ../scripts/check.mjs"
    },
    "files": [
        "dist/",
        "README.md"
    ],
    "keywords": [
        "mcp",
        "model-context-protocol",
        "browser-automation",
        "ai",
        "chrome",
        "firefox",
        "dom",
        "domagent",
        "cdp",
        "devtools-protocol"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vaishnavucv/domagent.git"
    },
    "homepage": "https://github.com/vaishnavucv/domagent#readme",
    "bugs": {
        "url": "https://github.com/vaishnavucv/domagent/issues"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.32.1",
        "ws": "8.22.0"
    },
    "devDependencies": {
        "@playwright/test": "1.58.2",
        "@types/node": "22.20.5",
        "@types/ws": "8.18.1",
        "esbuild": "0.25.12",
        "tsx": "4.21.0",
        "typescript": "5.9.3"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    }
}
