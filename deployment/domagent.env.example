DOMAGENT_ORIGIN=https://domagent.example.net
DOMAGENT_BIND=127.0.0.1
DOMAGENT_PORT=18792
DOMAGENT_DB=/var/lib/domagent/domagent.db
# Keep former control-plane origins protected until explicitly reviewed.
DOMAGENT_PROTECTED_ORIGINS=https://bananaclaw.example.net,https://identity.example.net
# Remote administration is DISABLED unless configured. Use a random 256-bit secret.
# Prefer a restricted regular file (0600); do not configure both forms.
# DOMAGENT_OPERATOR_SECRET_FILE=/etc/domagent/operator-secret
# DOMAGENT_OPERATOR_SECRET=<random 256-bit value in this protected/gitignored env file>
# Pairing HMAC secret defaults to securely generated DB metadata; optionally use:
# DOMAGENT_PAIRING_SECRET_FILE=/etc/domagent/pairing-secret
