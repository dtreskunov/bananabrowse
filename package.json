{
  "name": "domagent-private",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "npm --prefix domagent-mcp run build",
    "build:service": "npm --prefix domagent-mcp run build:service",
    "typecheck": "npm --prefix domagent-mcp run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm --prefix domagent-mcp run check",
    "test": "npm --prefix domagent-mcp test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-no-catch-all": "1.1.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
