{
  "manifest_version": 3,
  "name": "BananaBrowse",
  "version": "0.9.0.1",
  "description": "Let your AI agent work in browser tab groups you approve, from a small BananaBrowse window.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bananabrowse-secure@bananabrowse",
      "strict_min_version": "153.0"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "webNavigation",
    "notifications",
    "webRequest",
    "webRequestBlocking",
    "tabGroups",
    "contextMenus",
    "clipboardWrite",
    "sessions"
  ],
  "optional_permissions": [
    "userScripts"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Open BananaBrowse"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https: wss:; base-uri 'none'; frame-src 'none'"
  }
}
