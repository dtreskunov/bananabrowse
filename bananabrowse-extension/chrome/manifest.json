{
  "manifest_version": 3,
  "name": "BananaBrowse",
  "version": "0.9.0.2",
  "version_name": "1.0.0-beta.2",
  "minimum_chrome_version": "145",
  "description": "Let your AI agent work in browser tab groups you approve, from a small BananaBrowse window.",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "scripting",
    "userScripts",
    "webNavigation",
    "notifications",
    "declarativeNetRequest",
    "tabGroups",
    "contextMenus",
    "clipboardWrite"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open BananaBrowse"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https: wss:; base-uri 'none'; frame-src 'none'"
  }
}
