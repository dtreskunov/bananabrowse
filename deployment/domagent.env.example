DOMAGENT_ORIGIN=https://domagent.example.net
DOMAGENT_BIND=127.0.0.1
DOMAGENT_PORT=18792
DOMAGENT_DB=/var/lib/domagent/domagent.db
# Sessions can never share or open these origins (the service origin is always included).
DOMAGENT_PROTECTED_ORIGINS=https://identity.example.net
# One line per agent, generated by: node domagent-mcp/admin.js agent-key atlas "Atlas" https://atlas.example
# DOMAGENT_AGENT_ATLAS="Atlas|https://atlas.example/|sha256:<64 hex characters>"
