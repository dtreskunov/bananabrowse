{
  "manifest_version": 3,
  "name": "DomAgent Secure Pairing",
  "version": "5.0.8",
  "description": "Work with your assistant in locally activated tab groups and keep track in the native sidebar.",
  "browser_specific_settings": { "gecko": { "id": "domagent-secure@domagent", "strict_min_version": "153.0" } },
  "permissions": ["tabs", "storage", "scripting", "webNavigation", "notifications", "webRequest", "webRequestBlocking", "tabGroups", "contextMenus", "clipboardWrite"],
  "optional_permissions": ["userScripts"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["background.js"] },
  "action": { "default_title": "DomAgent — task workspace", "default_popup": "popup.html" },
  "sidebar_action": { "default_title": "DomAgent workspace", "default_panel": "panel.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src https: wss:; base-uri 'none'; frame-src 'none'" }
}
