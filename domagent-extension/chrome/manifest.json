{
  "manifest_version": 3,
  "name": "DomAgent Secure Pairing",
  "version": "3.0.1",
  "minimum_chrome_version": "118",
  "description": "Connect to your assistant and choose when to share a separate browser tab.",
  "permissions": ["debugger", "tabs", "storage", "scripting", "webNavigation", "notifications", "declarativeNetRequest"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "DomAgent — local control approvals", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https: wss:; base-uri 'none'; frame-src 'none'"
  }
}
