BANANABROWSE_ORIGIN=https://bananabrowse.example.net
BANANABROWSE_BIND=127.0.0.1
BANANABROWSE_PORT=18792
BANANABROWSE_DB=/var/lib/bananabrowse/bananabrowse.db
# Sessions can never share or open these origins (the service origin is always included).
BANANABROWSE_PROTECTED_ORIGINS=https://identity.example.net
# One line per agent, generated by: node bananabrowse-mcp/dist/bananabrowse-mcp/admin.js agent-key atlas "Atlas" https://atlas.example
# BANANABROWSE_AGENT_ATLAS="Atlas|https://atlas.example/|sha256:<64 hex characters>"
