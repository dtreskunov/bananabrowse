[Unit]
Description=DomAgent authenticated browser service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=domagent
Group=domagent
WorkingDirectory=/opt/domagent/domagent-mcp
EnvironmentFile=/etc/domagent/domagent.env
Environment=DOMAGENT_DB=/var/lib/domagent/domagent.db
Environment=DOMAGENT_OIDC_CLIENT_SECRET_FILE=%d/oidc-client-secret
LoadCredential=oidc-client-secret:/etc/domagent/oidc-client-secret
ExecStart=/usr/bin/node /opt/domagent/domagent-mcp/index.js
Restart=on-failure
RestartSec=5
StateDirectory=domagent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal
SyslogIdentifier=domagent

[Install]
WantedBy=multi-user.target
