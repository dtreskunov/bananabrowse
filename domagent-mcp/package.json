{
    "name": "domagent",
    "private": true,
    "version": "5.0.0-beta.7",
    "description": "MCP server for DOMAgent — let AI agents control your real browser via Chrome or Firefox extension",
    "main": "index.js",
    "type": "module",
    "bin": {
        "domagent": "./index.js"
    },
    "scripts": {
        "start": "node index.js",
        "test": "node --test test/*.test.js ../domagent-extension/test/*.test.js && npm --prefix ../domagent-extension/ui test",
        "build": "node ../scripts/build-extensions.mjs",
        "test:browser": "playwright test --config ../domagent-extension/playwright.config.cjs",
        "check": "node ../scripts/check.mjs"
    },
    "files": [
        "*.js",
        "README.md"
    ],
    "keywords": [
        "mcp",
        "model-context-protocol",
        "browser-automation",
        "ai",
        "chrome",
        "firefox",
        "dom",
        "domagent",
        "cdp",
        "devtools-protocol"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vaishnavucv/domagent.git"
    },
    "homepage": "https://github.com/vaishnavucv/domagent#readme",
    "bugs": {
        "url": "https://github.com/vaishnavucv/domagent/issues"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.32.1",
        "ws": "8.22.0"
    },
    "devDependencies": {
        "@playwright/test": "1.58.2",
        "esbuild": "0.25.12"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    }
}
